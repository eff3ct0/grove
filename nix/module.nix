self:
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.programs.grove;
  inherit (lib) mkOption types;

  home = config.home.homeDirectory;
  rootUnderHome = lib.hasPrefix "${home}/" cfg.root;
  # How the root reads in the generated text: ~/git rather than /home/<user>/git.
  rootShown = if rootUnderHome then "~/${lib.removePrefix "${home}/" cfg.root}" else cfg.root;

  gitName = lib.attrByPath [ "programs" "git" "settings" "user" "name" ] null config;

  package = pkgs.symlinkJoin {
    name = "grove-configured";
    paths = [ cfg.package ];
    nativeBuildInputs = [ pkgs.makeWrapper ];
    # Defaults only: GROVE_* set in the environment still win.
    postBuild = ''
      wrapProgram $out/bin/grove \
        --set-default GROVE_ROOT ${lib.escapeShellArg cfg.root} \
        --set-default GROVE_LOCAL_OWNER ${lib.escapeShellArg cfg.localOwner} \
        --set-default GROVE_DEFAULT_VISIBILITY ${cfg.defaultVisibility} \
        ${lib.optionalString (
          cfg.templates != null
        ) "--set-default GROVE_TEMPLATES ${lib.escapeShellArg cfg.templates}"}
    '';
  };

  secretsDoc =
    let
      rows = lib.concatLists (
        lib.mapAttrsToList (
          repo: paths: lib.mapAttrsToList (path: purpose: "| `${repo}` | `${path}` | ${purpose} |") paths
        ) cfg.secrets.paths
      );
    in
    ''
      ## Secrets

      Run anything that needs secrets as `${cfg.secrets.command} <path> -- <cmd>`. Paths each repo uses:

      | Repo | Path | Purpose |
      |---|---|---|
      ${lib.concatStringsSep "\n" rows}

      A repo or path missing from this table goes in `programs.grove.secrets.paths`, in the configuration that
      generates this file.
    '';

  text = lib.concatStringsSep "\n" (
    [ cfg.agentsDoc ]
    ++ lib.optional (cfg.secrets.paths != { }) secretsDoc
    ++ lib.optional (cfg.extraAgentsDoc != "") cfg.extraAgentsDoc
  );
in
{
  options.programs.grove = {
    enable = lib.mkEnableOption "grove, one clone per repo with agent work in sibling worktrees";

    package = mkOption {
      type = types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.grove;
      defaultText = lib.literalExpression "grove.packages.\${system}.grove";
      description = "The grove package.";
    };

    root = mkOption {
      type = types.str;
      default = "${home}/git";
      defaultText = lib.literalExpression ''"''${config.home.homeDirectory}/git"'';
      description = "Directory holding every clone, as `<root>/<owner>/<repo>`. Must be inside the home directory.";
    };

    localOwner = mkOption {
      type = types.str;
      default = "local";
      description = "Owner directory for repos with no remote, made by `grove new <repo>`.";
    };

    defaultVisibility = mkOption {
      type = types.enum [
        "private"
        "public"
      ];
      default = "private";
      description = "Visibility of the GitHub repos made by `grove new` and `grove publish`.";
    };

    templates = mkOption {
      type = types.nullOr (types.coercedTo types.path toString types.str);
      default = null;
      example = lib.literalExpression "inputs.self";
      description = "Flake whose templates `grove new -t <name>` uses (`nix flake init -t <templates>#<name>`).";
    };

    userName = mkOption {
      type = types.str;
      default = if gitName != null then gitName else config.home.username;
      defaultText = lib.literalExpression "config.programs.git.settings.user.name, else config.home.username";
      description = "Who the generated instructions name as deciding on PRs and merges.";
    };

    agentsDoc = mkOption {
      type = types.lines;
      default = ''
        # ${rootShown}

        Every project lives here: one clone per repo at `${rootShown}/<owner>/<repo>`, owner and name as GitHub spells
        them. A fork goes under the owner of its `origin`, with `upstream` pointing at the parent. This file is
        generated by home-manager (`programs.grove`): change it in that configuration.

        ## Get a repo

        - `grove clone <owner>/<repo>` (or its URL): clones into place and prints the path; if it is already there,
          only prints the path.
        - `grove new <owner>/<repo> [--public] [-t <template>]`: creates the repo on GitHub (${cfg.defaultVisibility}
          unless told otherwise) and prints its path.
        - `grove new <repo> [-t <template>]`: a local repo with no remote, at `${rootShown}/${cfg.localOwner}/<repo>`.

        ## Worktrees

        The main checkout of each repo stays clean on the default branch: it is the base worktrees come from. Work
        happens in a worktree of your own, next to the repo:

        - From the repo, `grove wt new agent/<topic>` → `${rootShown}/<owner>/<repo>.wt/agent-<topic>` on branch
          `agent/<topic>`. `cd` to the path it prints and work there. Agent branches always start with `agent/`.
        - Several agents in one repo: one worktree and one branch each.
        - `grove wt ls` shows every worktree under `${rootShown}` with its state. `grove wt gc` removes the ones no
          longer needed (clean, pushed, merged, unused for an hour); run it whenever you like.
        - `grove wt rm <path>` removes one worktree; it refuses while anything in it is unpushed.

        ## End of a session

        Commit and push your branch, unfinished work included (`wip: …`). GitHub is the only off-site copy: anything
        not pushed exists only on this disk.

        Local repos (`${rootShown}/${cfg.localOwner}/`, no remote) get commits only. Their only copy is this disk and
        its snapshots, if any; anything worth keeping goes to GitHub with `grove publish <owner>`.

        ${cfg.userName} decides on PRs and merges.

        ## Each repo

        Each repo's `AGENTS.md` says how to run it and how to test it. When that is missing or wrong, fix it in your
        branch.
      '';
      defaultText = lib.literalMD "Generic rules for working under `root` with grove.";
      description = "Instructions for agents working under `root`. Prefer `extraAgentsDoc` for additions.";
    };

    extraAgentsDoc = mkOption {
      type = types.lines;
      default = "";
      description = "Text appended after `agentsDoc` (and the secrets section): rules specific to this machine.";
    };

    secrets = {
      command = mkOption {
        type = types.nullOr types.str;
        default = null;
        example = "secrets-run";
        description = "Command that runs `<command> <path> -- <cmd>` with the secrets at `<path>` in the environment.";
      };

      paths = mkOption {
        type = types.attrsOf (types.attrsOf types.str);
        default = { };
        example = {
          "acme/api"."/stripe/api" = "payments in integration tests";
        };
        description = "Secret paths per repo: `\"<owner>/<repo>\" = { \"<path>\" = \"<purpose>\"; }`. Non-empty adds a secrets section.";
      };
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = rootUnderHome;
        message = "programs.grove.root (${cfg.root}) must be inside ${home}.";
      }
      {
        assertion = cfg.secrets.paths == { } || cfg.secrets.command != null;
        message = "programs.grove.secrets.paths needs programs.grove.secrets.command.";
      }
    ];

    home.packages = [ package ];

    # Agents read instruction files in parent directories. Both carry the full text: an `@AGENTS.md` import that
    # points outside the project asks for approval and is ignored in non-interactive runs.
    home.file = lib.mkIf rootUnderHome (
      let
        rel = lib.removePrefix "${home}/" cfg.root;
      in
      {
        "${rel}/AGENTS.md".text = text;
        "${rel}/CLAUDE.md".text = text;
      }
    );
  };
}
